# Development lewat Expo Go di HP: ubah ke IP LAN atau 0.0.0.0.
NOURISH_BIND_ADDRESS=127.0.0.1
NOURISH_GATEWAY_PORT=8081

# Ganti dengan alamat kontak tim untuk pemakaian Open Food Facts di luar development.
OFF_USER_AGENT="AmbatuNourish/0.1 (development)"
OFF_CACHE_TTL_SECONDS=
OFF_TIMEOUT_SECONDS=4

# Secret opsional, hanya untuk API server-to-server. Jangan masukkan ke EXPO_PUBLIC_*.
NOURISH_PARTNER_API_KEY=
TUNNEL_TOKEN=

# Core di STB -> gateway integrasi HTTPS. Gunakan key internal yang sama di kedua host.
NOURISH_INTEGRATION_BASE_URL=
NOURISH_INTEGRATION_API_KEY=

# Hanya untuk host integrasi di luar STB. Base URL mitra berakhir di /api/v1.
AMBATUFIT_BASE_URL=
AMBATUEAT_BASE_URL=https://pawpaw.stei.fun/api/v1
AMBATUEAT_API_KEY=
