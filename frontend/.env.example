# Base URL gateway AmbatuNourish (Nginx / Cloudflare Tunnel), tanpa garis miring di akhir.
# Contoh lokal: http://192.168.1.10:8081/api
EXPO_PUBLIC_API_URL=http://localhost:8081/api

# true  = pakai data contoh (fixture) di perangkat, tanpa backend. Semua data ditandai DEMO.
# false = pakai backend lewat gateway. Kontrak API AmbatuNourish masih PENDING (lihat README).
EXPO_PUBLIC_USE_MOCK=true
